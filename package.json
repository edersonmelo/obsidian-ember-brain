    "esbuild": "0.25.5",
    "eslint": "^9.30.1",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^16.3.0",
    "obsidian": "1.8.7",
    "tslib": "2.8.1",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.35.1"
  },
  "dependencies": {
    "d3-force": "3.0.0"
